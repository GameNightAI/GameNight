{
  "expo": {
    "name": "Klack: Game Night Planner",
    "slug": "klack",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "klack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klack-app.klack",
      "associatedDomains": [
        "applinks:klack.netlify.app",
        "applinks:klack-dev.netlify.app",
        "webcredentials:klack.netlify.app",
        "webcredentials:klack-dev.netlify.app",
        "activitycontinuation:klack.netlify.app",
        "activitycontinuation:klack-dev.netlify.app"
      ],
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "klack",
            "CFBundleURLSchemes": [
              "klack"
            ]
          },
          {
            "CFBundleURLName": "klack",
            "CFBundleURLSchemes": [
              "klack"
            ]
          }
        ],
        "NSCameraUsageDescription": "Klack needs camera access to take photos of your board game collection for AI analysis.",
        "NSPhotoLibraryUsageDescription": "Klack needs photo library access to select existing photos of your board game collection.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.klack_app.klack",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "klack"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "klack-llc",
          "project": "react-native"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25c621c2-d25e-4b68-b14f-525009067449"
      }
    },
    "owner": "klack-llc"
  }
}
